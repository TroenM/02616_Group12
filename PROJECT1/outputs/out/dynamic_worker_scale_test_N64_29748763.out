# LSBATCH: User input
#!/bin/bash
# Worker scaling test for the dynamic scheduler (25000x25000 image).
# LSF job arrays can't change the core count per element, so this script

IMAGE_SIZE="25000x25000"
WORKERS=(25 49 64 100 121)

#!/bin/bash
#BSUB -J dynamic_worker_scale_test_N64
#BSUB -o ../outputs/out/dynamic_worker_scale_test_N64_%J.out
#BSUB -e ../outputs/err/dynamic_worker_scale_test_N64_%J.err
#BSUB -q hpc
