# LSBATCH: User input
#!/bin/bash
#BSUB -J grid_image_scale_test[1-5]
#BSUB -o ../outputs/out/grid_image_scale_test%J_%I.out
#BSUB -e ../outputs/err/grid_image_scale_test%J_%I.err
